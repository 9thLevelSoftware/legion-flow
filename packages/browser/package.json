{
  "name": "@9thlevelsoftware/legion-flow-browser",
  "version": "0.0.0",
  "description": "Legion Flow browser checks: scripted, deterministic browser verification on playwright-core with request interception, host-side secret fill, and per-step evidence",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@9thlevelsoftware/legion-flow-schema": "workspace:*",
    "@9thlevelsoftware/legion-flow-engine": "workspace:*",
    "playwright-core": "1.64.0"
  }
}
