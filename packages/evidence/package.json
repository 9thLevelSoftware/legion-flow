{
  "name": "@9thlevelsoftware/legion-flow-evidence",
  "version": "0.0.0",
  "description": "Legion Flow evidence: an OpenTelemetry span exporter that writes step-batched OTLP-JSON span records as content-addressed run evidence",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@9thlevelsoftware/legion-flow-schema": "workspace:*",
    "@9thlevelsoftware/legion-flow-persist": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/resources": "2.12.0"
  }
}
