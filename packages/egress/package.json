{
  "name": "@9thlevelsoftware/legion-flow-egress",
  "version": "0.0.0",
  "description": "Legion Flow egress proxy: deny-all by construction, path-prefix routes to allowlisted hosts, secret headers set outside the agent, one log line per request",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@9thlevelsoftware/legion-flow-schema": "workspace:*"
  }
}
