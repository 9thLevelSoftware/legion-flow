{
  "name": "@9thlevelsoftware/legion-flow-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --no-bail run test",
    "validate:m0": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run check:skills",
    "check:skills": "node scripts/check-skills.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "5.9.3"
  }
}
